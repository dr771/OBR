{% comment %}
  OB: the icon set used by the PDP chrome, taken verbatim from the Bolt
  reference (Lucide, 24x24 viewBox, 2px round-capped strokes). Kept in one
  snippet so every surface draws the same glyph at the same weight — an icon
  substituted "because it's also a ruler" is how two surfaces end up with
  visibly different ink.

  Sizing and colour are the caller's job (CSS), not the SVG's: these carry no
  width/height so a class can size them, and stroke="currentColor" so they
  inherit ink.

  Accepts:
  - icon: {String} one of chevron-right | chevron-left | chevron-down | ruler
                          | truck | clock | shield-check | check
  - class: {String} optional class applied to the <svg>

  Usage:
  {% render 'ob-icon', icon: 'truck', class: 'ob-usp__icon' %}
{% endcomment %}

{%- capture ob_icon_paths -%}
  {%- case icon -%}
    {%- when 'chevron-right' -%}<path d="m9 18 6-6-6-6"/>
    {%- when 'chevron-left' -%}<path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'ruler' -%}<path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>
    {%- when 'truck' -%}<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
    {%- when 'shield-check' -%}<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
  {%- endcase -%}
{%- endcapture -%}

{%- assign ob_icon_paths = ob_icon_paths | strip -%}

{%- if ob_icon_paths != blank -%}
  <svg
    class="{{ class }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >{{ ob_icon_paths }}</svg>
{%- endif -%}
