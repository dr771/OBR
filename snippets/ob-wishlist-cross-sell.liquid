{% comment %}
  Wishlist cross-sell block for the cart drawer and /cart page
  (wishlist-integration). Two versions, chosen by the theme setting
  ob_wishlist_native:

  - Native: <ob-wishlist-list data-layout="compact"> (ob-wishlist-items.js),
    one server-rendered row per entry with dropdown pickers, add-to-cart
    (move-to-cart) and remove. Hidden by a :has() rule in
    component-ob-wishlist-native.css until a row has rendered.
  - Wishlist King: WK's <wishlist-page> element in compact mode (dropdown
    option pickers, add-to-cart CTA). The wrapper is hidden via a :has() rule
    in component-cart-drawer.css until WK renders at least one product card
    into it, so an empty wishlist (or WK not yet booted) shows nothing,
    including title and heading. The add-to-cart intercept lives in
    assets/ob-wishlist.js.

  Accepts:
  - context: {String} 'drawer' | 'page' — styling modifier only

  Usage:
  {% render 'ob-wishlist-cross-sell', context: 'drawer' %}
{% endcomment %}
{%- if settings.ob_wishlist_native -%}
  <div class="ob-wishlist-cross-sell ob-wishlist-cross-sell--native ob-wishlist-cross-sell--{{ context | default: 'page' }}">
    <a
      href="{{ routes.root_url | append: '/pages/favorieten' | replace: '//', '/' }}"
      class="ob-wishlist-cross-sell__title"
    >
      {{- 'sections.cart.wishlist_title' | t -}}
    </a>
    <p class="ob-wishlist-cross-sell__heading">{{ 'sections.cart.wishlist_heading' | t }}</p>
    <ob-wishlist-list class="ob-wishlist-cross-sell__list" data-layout="compact"></ob-wishlist-list>
  </div>
{%- else -%}
<div class="ob-wishlist-cross-sell ob-wishlist-cross-sell--{{ context | default: 'page' }}">
  <a href="/apps/wishlist" class="ob-wishlist-cross-sell__title">{{ 'sections.cart.wishlist_title' | t }}</a>
  <p class="ob-wishlist-cross-sell__heading">{{ 'sections.cart.wishlist_heading' | t }}</p>
  <wishlist-page
    show-product-title
    show-price
    cta-button="add-to-cart"
    product-options="dropdowns"
    move-to-cart
  ></wishlist-page>
  {%- comment -%}
    Template cloned by ob-wishlist.js into each WK-rendered .wk-form, right
    of the CTA. WK's own <remove-button> is a floating, JS-transform-positioned
    control (built for a card corner, like the PLP heart) — fighting that
    positioning to sit inline was more fragile than driving WK's real
    removeWishlistItem() API from a plain button we own.
  {%- endcomment -%}
  <template class="ob-wishlist-cross-sell__remove-template">
    <button
      type="button"
      class="ob-wishlist-cross-sell__remove"
      aria-label="{{ 'sections.cart.wishlist_remove_title' | t }}"
    >
      <span class="svg-wrapper">{{ 'icon-trash.svg' | inline_asset_content }}</span>
    </button>
  </template>
</div>
{%- endif -%}
