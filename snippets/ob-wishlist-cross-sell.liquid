{% comment %}
  Wishlist cross-sell block for the cart drawer and /cart page
  (wishlist-integration): <ob-wishlist-list data-layout="compact">
  (ob-wishlist-items.js), one server-rendered row per entry with dropdown
  pickers, add-to-cart (move-to-cart) and remove. Hidden by a :has() rule in
  component-ob-wishlist-native.css until a row has rendered, so an empty
  wishlist shows nothing, title and heading included.

  Accepts:
  - context: {String} 'drawer' | 'page' — styling modifier only

  Usage:
  {% render 'ob-wishlist-cross-sell', context: 'drawer' %}
{% endcomment %}
<div class="ob-wishlist-cross-sell ob-wishlist-cross-sell--native ob-wishlist-cross-sell--{{ context | default: 'page' }}">
  <a
    href="{{ routes.root_url | append: '/pages/favorieten' | replace: '//', '/' }}"
    class="ob-wishlist-cross-sell__title"
  >
    {{- 'sections.cart.wishlist_title' | t -}}
  </a>
  <p class="ob-wishlist-cross-sell__heading">{{ 'sections.cart.wishlist_heading' | t }}</p>
  <ob-wishlist-list class="ob-wishlist-cross-sell__list" data-layout="compact"></ob-wishlist-list>
</div>
