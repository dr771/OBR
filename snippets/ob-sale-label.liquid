{% comment %}
  Renders the sale-badge label for one color of a product (or the whole
  product when it has no color option).

  Sizes of one color can carry different reductions, and some none at all. The
  label is the plain rounded-down percentage when every available variant in
  scope is reduced by the same amount, and the largest one flagged as an
  "up to" value when they differ — a full-price size counts as 0%. The flag is
  a leading `~`; the caller renders the translated prefix
  (products.product.sale_up_to) in its own markup. Outputs nothing when no
  available variant in scope is reduced. A compare-at price of 0, unset, or not
  above the price is not a reduction (the Akeneo sync writes 0.00, not null).

  Accepts:
  - product: {Object} Product Liquid object
  - option_index: {Number} zero-based index of the color option (optional;
    omit to cover every variant)
  - option_value: {String} the color's option value (with option_index)

  Output examples: -14%   ~-50%

  Usage:
  {% render 'ob-sale-label', product: product, option_index: 0, option_value: 'Black' %}
{% endcomment %}

{%- liquid
  assign ob_sale_min = -1
  assign ob_sale_max = 0
  for variant in product.variants
    if option_index != blank and variant.options[option_index] != option_value
      continue
    endif
    unless variant.available
      continue
    endunless

    assign ob_sale_pct = 0
    if variant.compare_at_price > variant.price
      assign ob_sale_pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
    endif

    if ob_sale_min == -1 or ob_sale_pct < ob_sale_min
      assign ob_sale_min = ob_sale_pct
    endif
    if ob_sale_pct > ob_sale_max
      assign ob_sale_max = ob_sale_pct
    endif
  endfor
-%}
{%- if ob_sale_max > 0 -%}
  {%- if ob_sale_min != ob_sale_max -%}~{%- endif -%}
  -{{ ob_sale_max }}%
{%- endif -%}
