{% comment %}
  Renders the PLP product card's color swatch row.

  The global product-card setting keeps two reversible visual modes in this one
  renderer: flat/segmented color swatches from the matched variant's Akeneo
  filtercolors, or the existing cropped variant-photo chips. Color mode falls
  back per chip to the variant photo when no valid hex value resolves.

  Accepts:
  - card_product: {Object} Product Liquid object
  - card_variant: {Object} The variant the card represents (optional; defaults
    to selected_or_first_available_variant). Its color is the active chip.
  - card_has_reduced: {Boolean} The product has an available reduced variant,
    so each color is checked for one (optional)
  - card_size_values: {String} Sizes the listing is filtered to, as `|37|38|`
    (optional); with card_size_index, the size option's zero-based index

  Usage:
  {% render 'ob-card-swatches', card_product: card_product, card_variant: card_variant %}
{% endcomment %}
{%- liquid
  assign card_variant = card_variant | default: card_product.selected_or_first_available_variant
  assign swatch_visual_mode = settings.ob_plp_card_swatch_style | default: 'color'
  assign color_option = null
  for option in card_product.options_with_values
    capture kind
      render 'ob-option-meta', option_name: option.name
    endcapture
    assign kind = kind | strip
    if kind == 'color'
      assign color_option = option
      break
    endif
  endfor

  comment
    Parse every media item's color code ONCE per card, index-aligned with
    card_product.media. Resolving it per color x per media instead would mean
    ~400 render calls on a product like the 44-media / 8-color FitFlop Lulu.
    Blank codes become '-' so the joined string can't collapse and misalign
    the indexes.
  endcomment
  assign media_codes = ''
  for media in card_product.media
    capture media_code
      render 'ob-media-color-code', media: media
    endcapture
    assign media_code = media_code | strip
    if media_code == blank
      assign media_code = '-'
    endif
    if forloop.first
      assign media_codes = media_code
    else
      assign media_codes = media_codes | append: '@@' | append: media_code
    endif
  endfor
  assign media_codes = media_codes | split: '@@'

  comment
    Default second shot for the card's CURRENT image (the card variant).
    Color swatches (below) carry their own per-color swap2, but a single/no-color
    product renders no swatch row at all, so ensureHoverImage() in JS has nothing to
    read — this fallback holder is what it falls back to in that case.
  endcomment
  assign default_swap2_media = null
  assign default_variant = card_variant
  if default_variant.featured_image
    capture default_color_code
      render 'ob-media-color-code', image_src: default_variant.featured_image.src
    endcapture
    assign default_color_code = default_color_code | strip
    if default_color_code != blank
      assign matches = 0
      for media in card_product.media
        if media_codes[forloop.index0] == default_color_code
          assign matches = matches | plus: 1
          if matches == 2
            assign default_swap2_media = media
            break
          endif
        endif
      endfor
    endif
  endif
-%}
{%- if default_swap2_media -%}
  <span
    class="visually-hidden"
    aria-hidden="true"
    data-ob-card-default-swap2
    data-ob-swap2-src="{{ default_swap2_media | image_url: width: 533 }}"
    data-ob-swap2-srcset="{{ default_swap2_media | image_url: width: 360 }} 360w, {{ default_swap2_media | image_url: width: 533 }} 533w, {{ default_swap2_media | image_url: width: 720 }} 720w"
  ></span>
{%- endif -%}
{%- if color_option and color_option.values.size > 1 -%}
  {%- comment -%}
    The chips ride a single-row rail (see ob-option-rail.js), so a many-colour
    product can't wrap its card into a taller, ragged tile. Chip size comes from
    the rail width — five full chips plus a peek at the sixth.
  {%- endcomment -%}
  <div class="ob-card-swatches" data-ob-card-swatches data-ob-option-rail-shell>
    <div class="ob-card-swatches__rail" data-ob-option-rail data-ob-option-rail-step="item">
    {%- assign color_index = color_option.position | minus: 1 -%}
    {%- assign active_color = card_variant.options[color_index] -%}
    {%- assign size_filtered = false -%}
    {%- if card_size_values != blank and card_size_index != blank -%}
      {%- assign size_filtered = true -%}
    {%- endif -%}
    {%- for value in color_option.values -%}
      {%- liquid
        comment
          swatch_variant: this color's first variant (image, fill). sale_variant:
          its first available reduced variant — only looked for when the
          product has one. size_variant: this color in a size the listing is
          filtered to — only looked for under a size filter. The chip links to
          the filtered size first, then the reduced variant, then the first.
          The badge label is per color.
        endcomment
        assign swatch_variant = null
        assign sale_variant = null
        assign size_variant = null
        for variant in card_product.variants
          if variant.options[color_index] != value.name
            continue
          endif
          unless swatch_variant
            assign swatch_variant = variant
          endunless
          if variant.available
            if card_has_reduced and sale_variant == null and variant.compare_at_price > variant.price
              assign sale_variant = variant
            endif
            if size_filtered and size_variant == null
              assign size_token = '|' | append: variant.options[card_size_index] | append: '|'
              if card_size_values contains size_token
                assign size_variant = variant
              endif
            endif
          endif

          assign keep_scanning = false
          if card_has_reduced and sale_variant == null
            assign keep_scanning = true
          endif
          if size_filtered and size_variant == null
            assign keep_scanning = true
          endif
          unless keep_scanning
            break
          endunless
        endfor

        assign chip_variant = size_variant | default: sale_variant | default: swatch_variant
        assign sale_label = blank
        if sale_variant
          capture sale_label
            render 'ob-sale-label', product: card_product, option_index: color_index, option_value: value.name
          endcapture
          assign sale_label = sale_label | strip
        endif
        assign sale_range = false
        if sale_label contains '~'
          assign sale_range = true
          assign sale_label = sale_label | remove: '~'
        endif

        comment
          The active chip links to the card variant itself, so re-selecting it
          never moves the link off a size the listing was filtered to.
        endcomment
        assign chip_active = false
        if value.name == active_color
          assign chip_active = true
          assign chip_variant = card_variant
        endif
      -%}
      {%- liquid
        comment
          This color's SECOND shot, for the hover pair: the next media whose
          filename code matches the color's own first image. Colors with only
          one shot get no pair and fall back to Dawn's single-image behavior.
        endcomment
        assign swap2_media = null
        if swatch_variant.featured_image
          capture color_code
            render 'ob-media-color-code', image_src: swatch_variant.featured_image.src
          endcapture
          assign color_code = color_code | strip
          if color_code != blank
            assign matches = 0
            for media in card_product.media
              if media_codes[forloop.index0] == color_code
                assign matches = matches | plus: 1
                if matches == 2
                  assign swap2_media = media
                  break
                endif
              endif
            endfor
          endif
        endif

        assign value_name_escaped = value.name | escape
        assign swatch_fill = blank
        if swatch_visual_mode == 'color'
          capture swatch_fill
            render 'ob-variant-color-swatch-style', variant: swatch_variant
          endcapture
          assign swatch_fill = swatch_fill | strip
        endif

        assign use_image_chip = false
        if swatch_visual_mode == 'image' or swatch_fill == blank
          assign use_image_chip = true
        endif

        assign chip_unavailable = false
        if swatch_fill == blank and swatch_variant.featured_image == nil
          assign chip_unavailable = true
        endif
      -%}
      <button
        type="button"
        class="ob-card-swatch{% if swatch_fill != blank %} ob-card-swatch--color{% else %} ob-card-swatch--image{% endif %}{% if chip_active %} ob-card-swatch--active{% endif %}{% if chip_unavailable %} ob-card-swatch--unavailable{% endif %}"
        aria-label="{{ 'products.product.color_label' | t: color: value.name | escape }}"
        aria-pressed="{% if chip_active %}true{% else %}false{% endif %}"
        data-ob-swatch-name="{{ value_name_escaped }}"
        {% if swatch_fill != blank %}style="--ob-card-swatch-fill: {{ swatch_fill }};"{% endif %}
        {% if chip_variant %}data-ob-variant-id="{{ chip_variant.id }}"{% endif %}
        {% if sale_label != blank %}data-ob-sale-label="{{ sale_label }}"{% endif %}
        {% if sale_range %}data-ob-sale-range{% endif %}
        {% if swatch_variant.featured_image %}
          data-ob-swap-src="{{ swatch_variant.featured_image | image_url: width: 533 }}"
          data-ob-swap-srcset="{{ swatch_variant.featured_image | image_url: width: 360 }} 360w, {{ swatch_variant.featured_image | image_url: width: 533 }} 533w, {{ swatch_variant.featured_image | image_url: width: 720 }} 720w"
        {% endif %}
        {% if swap2_media %}
          data-ob-swap2-src="{{ swap2_media | image_url: width: 533 }}"
          data-ob-swap2-srcset="{{ swap2_media | image_url: width: 360 }} 360w, {{ swap2_media | image_url: width: 533 }} 533w, {{ swap2_media | image_url: width: 720 }} 720w"
        {% endif %}
      >
        {%- if use_image_chip and swatch_variant.featured_image -%}
          {%- comment -%}
            A chip is ~50px on the desktop card and ~63px on the wider homepage
            card, so a 64px source is already below 1x there and visibly soft at
            2x/3x. Ask for 200 and let srcset pick.
          {%- endcomment -%}
          {{
            swatch_variant.featured_image
            | image_url: width: 200, height: 200, crop: 'center'
            | image_tag: loading: 'lazy', alt: value_name_escaped, sizes: '64px', widths: '64,100,150,200'
          }}
        {%- endif -%}
      </button>
    {%- endfor -%}
    </div>
    {%- assign colors_previous_label = 'products.product.colors_previous' | t -%}
    {%- assign colors_next_label = 'products.product.colors_next' | t -%}
    {% render 'ob-option-rail-controls',
      previous_label: colors_previous_label,
      next_label: colors_next_label,
      class_root: 'ob-card-swatches__button'
    %}
  </div>
{%- endif -%}
