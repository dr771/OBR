{% comment %}
  Mobile collection/search filter bar. Replaces Dawn's menu drawer for the
  vertical and horizontal layouts while retaining FacetFiltersFormMobile so
  facets.js keeps its native serialization and AJAX rendering contracts.

  Accepts:
  - ob_in_stock_only: {Boolean} availability is forced (plp-hide-sold-out); keeps it out of the active-filter count
{% endcomment %}

{%- if enable_filtering or enable_sorting -%}
  {%- liquid
    assign color_filter_input_type = 'checkbox'
    if settings.ob_color_filter_selection_mode == 'single'
      assign color_filter_input_type = 'radio'
    endif
  -%}
  <facet-filters-form class="facets ob-mobile-bar medium-hide large-up-hide">
    <form id="FacetFiltersFormMobile" class="ob-mobile-bar__form">
      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}
      {%- if results.current_vendor or results.current_type -%}
        <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
      {%- endif -%}

      {%- liquid
        assign total_active_values = 0
        if enable_filtering
          for filter in results.filters
            # plp-hide-sold-out: the forced availability filter never counts as a shopper's filter.
            if ob_in_stock_only and filter.param_name == 'filter.v.availability'
              continue
            endif
            assign total_active_values = total_active_values | plus: filter.active_values.size
            if filter.type == 'price_range' and filter.min_value.value != null or filter.type == 'price_range' and filter.max_value.value != null
              assign total_active_values = total_active_values | plus: 1
            endif
          endfor
        endif
      -%}

      <div class="ob-mobile-bar__toolbar">
        {%- if enable_sorting -%}
          <div id="Details-Mobile-SortBy-{{ section.id }}" class="ob-mobile-bar__sort js-filter" data-index="bar-sort">
            <label for="SortBy-mobile" class="visually-hidden">{{ 'products.facets.sort_by_label' | t }}</label>
            <div class="select">
              <span class="ob-mobile-bar__sort-label" aria-hidden="true">
                {{- 'products.facets.sort_by_label' | t | remove: ':' -}}
              </span>
              <select
                name="sort_by"
                class="select__select"
                id="SortBy-mobile"
                aria-describedby="a11y-refresh-page-message"
              >
                {%- if request.page_type == 'collection' -%}
                  {% render 'ob-plp-sort-options', collection: results, sort_by: sort_by %}
                {%- else -%}
                  {%- for option in results.sort_options -%}
                    <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected="selected"{% endif %}>
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                {%- endif -%}
              </select>
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </div>
          </div>
        {%- endif -%}

        {%- if enable_filtering -%}
          <button
            type="button"
            class="ob-mobile-bar__toggle"
            aria-expanded="false"
            aria-controls="ObMobileBarPanel-{{ section.id }}"
            data-ob-bar-toggle
          >
            <span class="ob-mobile-bar__toggle-label">
              {{- 'products.facets.filter_bar_toggle' | t -}}
              {%- comment -%}
                The panel starts closed and rows carry no pills, so the toggle is the
                only place an active filter shows while it stays closed. A .js-filter
                so facets.js refreshes it on every response; always rendered so it
                is never dropped as a facet "no longer returned".
              {%- endcomment -%}
              <span id="Details-Bar-Count-{{ section.id }}" class="js-filter ob-mobile-bar__toggle-count" data-index="bar-count">
                {%- if total_active_values > 0 %} ({{ total_active_values }}){% endif -%}
              </span>
            </span>
            <span class="ob-mobile-bar__toggle-icon ob-mobile-bar__toggle-icon--open svg-wrapper">
              {{- 'icon-filter.svg' | inline_asset_content -}}
            </span>
            <span class="ob-mobile-bar__toggle-icon ob-mobile-bar__toggle-icon--close svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}
      </div>

      {%- if enable_filtering -%}
        <div id="ObMobileBarPanel-{{ section.id }}" class="ob-mobile-bar__panel" data-ob-bar-panel hidden>
          {%- liquid
            if results.url
              assign results_url = results.url
            else
              assign terms = results.terms | escape
              assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
            endif
          -%}
          {%- comment -%} Always rendered: a .js-filter must exist for facets.js to fill it. {%- endcomment -%}
          <span id="Details-Bar-Reset-{{ section.id }}" class="js-filter ob-mobile-bar__reset" data-index="bar-reset">
            {%- if total_active_values > 0 -%}
              <facet-remove>
                <a href="{{ results_url }}" class="ob-mobile-bar__reset-link">{{ 'products.facets.clear_all' | t }}</a>
              </facet-remove>
            {%- endif -%}
          </span>
          {%- assign bar_kinds = 'gender,brand,size,color,category,activity' | split: ',' -%}
          {%- for bar_kind in bar_kinds -%}
            {%- for filter in results.filters -%}
              {%- liquid
                assign filter_kind = 'generic'
                if filter.param_name contains 'custom.genderid'
                  assign filter_kind = 'gender'
                elsif filter.param_name == 'filter.p.vendor'
                  assign filter_kind = 'brand'
                elsif filter.param_name contains 'originalbrands_cat'
                  # DEV: custom.shopify_originalbrands_category; pre-live: akeneo.shopify_originalbrands_cate__1
                  assign filter_kind = 'category'
                elsif filter.param_name contains 'custom.activities'
                  assign filter_kind = 'activity'
                elsif filter.param_name contains 'available_erp_sizes'
                  assign filter_kind = 'size'
                elsif filter.param_name contains 'filtercolors'
                  assign filter_kind = 'color'
                endif
              -%}
              {%- liquid
                assign renders_row = false
                if filter_kind == bar_kind
                  if filter.values.size > 1 or filter.active_values.size > 0
                    assign renders_row = true
                  endif
                endif
              -%}
              {%- if renders_row -%}
                <div
                  id="Details-Bar-{{ filter.param_name | escape }}-{{ section.id }}"
                  class="js-filter ob-mobile-bar__filter"
                  data-index="bar-{{ bar_kind }}"
                >
                  <h2 class="ob-mobile-bar__row-heading caption-large text-body">
                    {%- if filter_kind == 'size' or filter_kind == 'color' -%}
                      {%- render 'ob-option-meta', option_name: filter.param_name, field: 'label' -%}
                    {%- else -%}
                      {{- filter.label | escape -}}
                    {%- endif -%}
                  </h2>
                  <ul class="ob-mobile-bar__row ob-mobile-bar__row--{{ filter_kind }} list-unstyled" role="list">
                    {%- assign sorted_values = filter.values -%}
                    {%- if filter.operator == 'AND' -%}
                      {%- assign active_filter_values = filter.values | where: 'active', true -%}
                      {%- assign inactive_filter_values = filter.values | where: 'active', false -%}
                      {%- assign sorted_values = active_filter_values | concat: inactive_filter_values -%}
                    {%- endif -%}
                    {%- for value in sorted_values -%}
                      {%- liquid
                        assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-bar-' | append: forloop.index
                        assign is_disabled = false
                        if value.count == 0 and value.active == false
                          assign is_disabled = true
                        endif
                      -%}
                      {%- comment -%}
                        Metaobject-backed facets read their label from the metaobject
                        itself, not from Shopify's filter index — see ob-facet-value-label.
                      {%- endcomment -%}
                      {%- capture ob_value_label -%}
                        {%- render 'ob-facet-value-label', value: value, param_name: filter.param_name -%}
                      {%- endcapture -%}
                      <li>
                        {%- if filter_kind == 'color' -%}
                          <div
                            class="facets__label{% if is_disabled %} disabled{% endif %}{% if value.active %} active{% endif %} ob-color-facet-option"
                            data-ob-swatch-name="{{ ob_value_label }} ({{ value.count }})"
                          >
                            <div class="swatch-input-wrapper">
                              {% render 'ob-facet-swatch-input',
                                id: input_id,
                                type: color_filter_input_type,
                                name: value.param_name,
                                value: value.value,
                                value_obj: value,
                                label_text: ob_value_label,
                                product_form_id: 'FacetFiltersFormMobile',
                                checked: value.active,
                                disabled: is_disabled
                              %}
                            </div>
                          </div>
                        {%- else -%}
                          <label
                            for="{{ input_id }}"
                            class="ob-mobile-bar__box{% if is_disabled %} disabled{% endif %}"
                          >
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              id="{{ input_id }}"
                              {% if value.active %}checked{% endif %}
                              {% if is_disabled %}disabled{% endif %}
                            >
                            <span aria-hidden="true">{{ ob_value_label }}</span>
                            <span class="visually-hidden">
                              {{- ob_value_label }} ({{ 'products.facets.product_count_simple' | t: count: value.count }})
                            </span>
                          </label>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}

          {%- comment -%}
            A .js-filter so facets.js re-renders it on every response: which values
            pass through changes when a row collapses. A span, not a div, because
            the last-row spacing relies on .ob-mobile-bar__filter:last-of-type.
          {%- endcomment -%}
          <span id="Details-Bar-Passthrough-{{ section.id }}" class="js-filter" data-index="bar-passthrough" hidden>
            {%- for filter in results.filters -%}
              {%- liquid
                assign has_bar_row = false
                if filter.param_name contains 'custom.genderid' or filter.param_name == 'filter.p.vendor' or filter.param_name contains 'originalbrands_cat' or filter.param_name contains 'custom.activities' or filter.param_name contains 'available_erp_sizes' or filter.param_name contains 'filtercolors'
                  if filter.values.size > 1 or filter.active_values.size > 0
                    assign has_bar_row = true
                  endif
                endif
              -%}
              {%- unless has_bar_row -%}
                {%- if filter.type == 'price_range' -%}
                  {%- if filter.min_value.value -%}
                    <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}">
                  {%- endif -%}
                  {%- if filter.max_value.value -%}
                    <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}">
                  {%- endif -%}
                {%- else -%}
                  {%- for value in filter.active_values -%}
                    <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
                  {%- endfor -%}
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          </span>
        </div>
      {%- endif -%}
    </form>
  </facet-filters-form>
  <script>
    /* Only rows that overflow show a scrollbar - a classic one below the
       row, an overlay one (Android) inside its bottom padding. Flag those
       rows so the gap to the next row is measured from the scrollbar rather
       than the boxes. Runs inline so the first paint has the right spacing. */
    (function () {
      var bar = document.getElementById('ObMobileBarPanel-{{ section.id }}');
      bar = bar && bar.closest('.ob-mobile-bar');
      if (!bar) return;
      var mark = function () {
        bar.querySelectorAll('.ob-mobile-bar__row').forEach(function (row) {
          row.classList.toggle('has-scrollbar', row.scrollWidth > row.clientWidth + 1);
        });
      };
      mark();
      new MutationObserver(mark).observe(bar, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
      window.addEventListener('resize', mark);
    })();
  </script>
{%- endif -%}
