{% comment %}
  Shared previous/next controls for a single-row option rail (PDP option
  pickers, PLP card colour chips). Drop them inside the rail's
  `[data-ob-option-rail-shell]`; ob-option-rail.js wires them up and each
  surface's own stylesheet decides where they sit and when they show.

  Accepts:
  - previous_label: {String} Accessible label for the previous control.
  - next_label: {String} Accessible label for the next control.
  - class_root: {String} Base class for both buttons, so a surface can style
    its own controls without loading another surface's stylesheet.
    Default: 'product-form__option-rail-button' (the PDP rail).
{% endcomment %}
{%- assign rail_button_class = class_root | default: 'product-form__option-rail-button' -%}
<button
  type="button"
  class="{{ rail_button_class }} {{ rail_button_class }}--previous"
  data-ob-option-rail-previous
  aria-label="{{ previous_label | escape }}"
>
  {{- 'icon-caret.svg' | inline_asset_content -}}
</button>
<button
  type="button"
  class="{{ rail_button_class }} {{ rail_button_class }}--next"
  data-ob-option-rail-next
  aria-label="{{ next_label | escape }}"
>
  {{- 'icon-caret.svg' | inline_asset_content -}}
</button>
