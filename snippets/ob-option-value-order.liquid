{% comment %}
  Returns the original zero-based indexes of a ProductOptionValue array in
  storefront order. Every size option is ordered, whatever its Akeneo key:
  letter sizes first (3XS..6XL), then numbered sizes (EU 38, waist W32, kids
  104, half sizes 36.5) ascending. A range (S_M, 116_128) ranks right after its
  first size. Unknown values follow in their original relative order, and
  non-size options stay entirely in source order. Keeping indexes lets
  product-variant-options reuse the original drops and all Dawn metadata
  unchanged. JS twin: sortSizeValues in assets/ob-size-memory.js.

  Accepts:
  - option: {ProductOptionDrop}
  - kind: {String} option kind from ob-option-meta; only 'size' is reordered

  Output: comma-separated zero-based indexes, e.g. `0,1,2,6,4,3,7,5`
{% endcomment %}
{%- liquid
  assign letter_sizes = '3XS|XXS|XS|S|M|L|XL|XXL|3XL|4XL|5XL|6XL' | split: '|'
  assign digits = '0123456789' | split: ''
  assign sort_keys = ''

  for value in option.values
    # Sort key: group (1 letter, 2 number, 9 unknown), first size rank, second
    # size rank + 1 for a range (0 for a single size), source index; zero-padded
    # so a plain string sort orders them.
    assign group = '9'
    assign primary = 0
    assign secondary = 0

    if kind == 'size'
      assign parts = value | strip | upcase | split: '_'
      if parts.size == 1 or parts.size == 2
        for part in parts
          # Akeneo also writes the long forms (XXXL, XXXXL); compare them as 3XL, 4XL.
          assign part_label = part | strip | replace: 'XXXXXXL', '6XL' | replace: 'XXXXXL', '5XL' | replace: 'XXXXL', '4XL' | replace: 'XXXL', '3XL' | replace: 'XXXS', '3XS'
          assign part_group = '9'
          assign part_rank = 0

          for letter_size in letter_sizes
            if part_label == letter_size
              assign part_group = '1'
              assign part_rank = forloop.index
            endif
          endfor

          if part_group == '9'
            assign number_label = part_label
            if number_label contains 'W'
              assign first_char = number_label | slice: 0
              if first_char == 'W'
                assign number_label = number_label | remove_first: 'W'
              endif
            endif
            assign number_label = number_label | replace: ',', '.'
            assign leftover = number_label | remove_first: '.'
            for digit in digits
              assign leftover = leftover | remove: digit
            endfor
            if leftover == '' and number_label != '' and number_label != '.'
              assign part_rank = number_label | times: 100 | round
              if part_rank < 1000000
                assign part_group = '2'
              endif
            endif
          endif

          if forloop.first
            assign group = part_group
            assign primary = part_rank
          elsif part_group == group
            assign secondary = part_rank | plus: 1
          else
            assign group = '9'
          endif
        endfor
      endif

      if group == '9'
        assign primary = 0
        assign secondary = 0
      endif
    endif

    assign padded_primary = primary | prepend: '000000' | slice: -6, 6
    assign padded_secondary = secondary | prepend: '000000' | slice: -6, 6
    assign padded_index = forloop.index0 | prepend: '0000' | slice: -4, 4
    assign sort_keys = sort_keys | append: group | append: padded_primary | append: padded_secondary | append: padded_index | append: ','
  endfor

  assign sort_keys = sort_keys | split: ',' | sort
  for sort_key in sort_keys
    unless forloop.first
      echo ','
    endunless
    echo sort_key | slice: 13, 4 | plus: 0
  endfor
-%}
