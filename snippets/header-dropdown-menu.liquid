{% doc %}
  Renders the desktop dropdown navigation.

  @param {section} section - The header section and its menu settings

  @example
  {% render 'header-dropdown-menu', section: section %}
{% enddoc %}

{%- comment -%}
  A brand collection can sit under more than one top-level item at once (its
  own needs-collection, e.g. Fashion & Lifestyle, AND the Merken directory),
  so Shopify's own `child_active` fires true on every branch that contains it
  — there's no "primary parent" concept in the Menu API. Merken is the one
  branch that deliberately never wins that tie (same as it's left unset in
  `custom.breadcrumb_rank`, see COLLECTIONS.md): it's a directory of every
  brand, not a specific location, so a more specific top-level item should
  get the active state instead whenever one also matches.
{%- endcomment -%}
{%- liquid
  assign non_merken_link_active = false
  for link in section.settings.menu.links
    unless link.handle == 'merken'
      if link.current or link.child_active
        assign non_merken_link_active = true
      endif
    endunless
  endfor
-%}
<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign link_is_active = false
        if link.current or link.child_active
          assign link_is_active = true
        endif
        if link.handle == 'merken' and non_merken_link_active
          assign link_is_active = false
        endif
      -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu class="header__dropdown-menu">
            <div class="header__menu-parent{% if link_is_active %} header__menu-parent--active{% endif %}">
              <a
                id="HeaderMenu-{{ link.handle }}"
                href="{{ link.url }}"
                class="header__menu-item header__top-level-link list-menu__item link link--text"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                <span
                  {%- if link_is_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
              </a>
              <details id="Details-HeaderMenu-{{ forloop.index }}" class="header__submenu-details">
                <summary
                  id="HeaderMenuToggle-{{ link.handle }}"
                  class="header__submenu-toggle"
                  aria-labelledby="HeaderMenu-{{ link.handle }}"
                  aria-controls="HeaderMenu-MenuList-{{ forloop.index }}"
                >
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </summary>
                <ul
                  id="HeaderMenu-MenuList-{{ forloop.index }}"
                  class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                  role="list"
                  tabindex="-1"
                >
                  {%- for childlink in link.links -%}
                    <li>
                      {%- if childlink.links == blank -%}
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="header__menu-item list-menu__item link link--text focus-inset caption-large"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          <span
                            {%- if childlink.current %}
                              class="header__active-menu-item"
                            {% endif %}
                          >
                            {{- childlink.title | escape -}}
                          </span>
                        </a>
                      {%- else -%}
                        <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                          <summary
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                          >
                            <span>{{ childlink.title | escape }}</span>
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                          </summary>
                          <ul
                            id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}"
                            class="header__submenu list-menu motion-reduce"
                          >
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a
                                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{{ grandchildlink.url }}"
                                  class="header__menu-item list-menu__item link link--text focus-inset caption-large"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  <span
                                    {%- if grandchildlink.current %}
                                      class="header__active-menu-item"
                                    {% endif %}
                                  >
                                    {{- grandchildlink.title | escape -}}
                                  </span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            </div>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item header__top-level-link list-menu__item link link--text"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
