{% comment %}
  OB: every real /collections/* page's hero now shares the tinted collection
  hero built for the Merken directory (see the
  ob-collection-hero-and-merken-directory spec). Dawn's original side-by-side
  collection-image layout is dropped entirely - no live collection currently
  sets show_collection_image (confirmed in templates/collection.json before
  this change), and the approved reusable hero has no image slot.
{% endcomment %}
{%- liquid
  assign ob_subheading = blank
  if section.settings.show_collection_description
    assign ob_subheading = collection.description
  endif
-%}

{%- render 'ob-collection-hero', title: collection.title, subheading: ob_subheading -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    }
  ]
}
{% endschema %}
