{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-ob-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  comment
    OB promo schedule (spec: header-announcement-bar). A block linked to a
    campaign collection borrows that collection's run time (ob-campaign-window).
    Blocks already ended at render time are dropped here; blocks not yet started
    are rendered hidden and the inline script after the bar reveals them on the
    shopper's clock, so a page cached before the start still shows the message
    on time. ob_live_ids lists the kept block ids (",id,id,"), and ob_live_count
    replaces section.blocks.size for the single-message vs slider choice.
  endcomment
  assign ob_now = 'now' | date: '%s' | plus: 0
  assign ob_live_ids = ','
  assign ob_live_count = 0
  assign ob_has_schedule = false
  for block in section.blocks
    if block.settings.campaign != blank
      capture ob_window
        render 'ob-campaign-window', collection: block.settings.campaign
      endcapture
      assign ob_window_end = ob_window | split: ',' | last | plus: 0
      if ob_window_end <= ob_now
        continue
      endif
      assign ob_has_schedule = true
    endif
    assign ob_live_ids = ob_live_ids | append: block.id | append: ','
    assign ob_live_count = ob_live_count | plus: 1
  endfor
  if ob_live_count > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div
  id="UtilityBar-{{ section.id }}"
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and ob_live_count > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if ob_live_count == 1 -%}
      {%- for block in section.blocks -%}
        {%- capture ob_block_key -%},{{ block.id }},{%- endcapture -%}
        {%- unless ob_live_ids contains ob_block_key -%}
          {%- continue -%}
        {%- endunless -%}
        <div
          class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
          role="region"
          aria-label="{{ 'sections.header.announcement' | t }}"
          data-ob-message
          {% if block.settings.campaign != blank %}
            {% render 'ob-campaign-window', collection: block.settings.campaign, output: 'attrs' %}
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="announcement-bar__link link link--text focus-inset animate-arrow"
              >
            {%- endif -%}
            <p class="announcement-bar__message h5">
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                {%- render 'ob-icon', icon: block.settings.icon, class: 'announcement-bar__icon' -%}
              {%- endif -%}
              <span>{{ block.settings.text | escape }}</span>
              {%- if block.settings.link != blank -%}
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              {%- endif -%}
            </p>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- elsif ob_live_count > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- assign ob_slide_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- capture ob_block_key -%},{{ block.id }},{%- endcapture -%}
              {%- unless ob_live_ids contains ob_block_key -%}
                {%- continue -%}
              {%- endunless -%}
              {%- assign ob_slide_index = ob_slide_index | plus: 1 -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ ob_slide_index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ ob_slide_index }} {{ 'general.slider.of' | t }} {{ ob_live_count }}"
                tabindex="-1"
                data-ob-message
                {% if block.settings.campaign != blank %}
                  {% render 'ob-campaign-window', collection: block.settings.campaign, output: 'attrs' %}
                {% endif %}
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                        {%- render 'ob-icon', icon: block.settings.icon, class: 'announcement-bar__icon' -%}
                      {%- endif -%}
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if ob_has_schedule -%}
  {%- comment -%}
    Re-checks scheduled messages on the shopper's clock (the render-time choice
    is only as fresh as the page cache). Inline and synchronous on purpose: it
    must run before Dawn's deferred slideshow-component initialises, because
    the slider pages and autoplays over the slides that have a width — hidden
    ones drop out. One message left: controls hidden and autoplay off (Dawn's
    fade classes could otherwise park the only message at opacity 0). None
    left: the whole bar goes, unless it also hosts social links or selectors.
  {%- endcomment -%}
  <script>
    (function (bar) {
      if (!bar) return;
      var now = Date.now() / 1000;
      var shown = 0;
      bar.querySelectorAll('[data-ob-message]').forEach(function (message) {
        var start = message.getAttribute('data-ob-window-start');
        var end = message.getAttribute('data-ob-window-end');
        var visible = (!start || now >= Number(start)) && (!end || now < Number(end));
        message.hidden = !visible;
        if (visible) shown += 1;
      });
      if (shown === 0 && !bar.querySelector('localization-form, .list-social')) {
        bar.hidden = true;
      } else if (shown <= 1) {
        bar.classList.add('ob-announcement--single');
        var slider = bar.querySelector('[data-autoplay]');
        if (slider) slider.setAttribute('data-autoplay', 'false');
      }
    })(document.getElementById('UtilityBar-{{ section.id }}'));
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },    
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },  
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
         "content": "t:sections.announcement-bar.settings.paragraph.content"
    },             
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh-cw", "label": "Refresh" },
            { "value": "shield-check", "label": "Shield check" },
            { "value": "clock", "label": "Clock" },
            { "value": "check", "label": "Check" },
            { "value": "ruler", "label": "Ruler" }
          ]
        },
        {
          "type": "collection",
          "id": "campaign",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.campaign.label",
          "info": "t:sections.announcement-bar.blocks.announcement.settings.campaign.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
