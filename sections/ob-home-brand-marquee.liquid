{% comment %}
  OB: the homepage brand marquee, the one place its brands are managed. It is its
  own section so any hero, present or future, gets it by sitting above it and
  needs no marquee code. component-ob-home-hero.css moves it between that hero's
  copy and photo below 750px.

  The block list is rendered twice back-to-back so a -50%-of-one-set translateX
  loops seamlessly; assets/ob-home-marquee.js drives that translateX itself (not a
  CSS keyframe - see that file for why).
{% endcomment %}
{{ 'component-ob-home-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ob-home-marquee.js' | asset_url }}" defer></script>

<div class="ob-home-marquee">
  <div class="ob-home-marquee__track">
    {%- for copy in (1..2) -%}
      <div class="ob-home-marquee__set" aria-hidden="{% unless copy == 1 %}true{% endunless %}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign ob_mq_handle = block.settings.collection.handle | default: block.settings.brand_handle
            assign ob_mq_url = block.settings.collection.url
            if ob_mq_url == blank and block.settings.brand_handle != blank
              assign ob_mq_url = routes.collections_url | append: '/' | append: block.settings.brand_handle
            endif
          -%}
          {%- if ob_mq_handle != blank -%}
            <a
              href="{{ ob_mq_url }}"
              class="ob-home-marquee__item"
              {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}
              {% if copy == 2 %}tabindex="-1"{% endif %}
            >
              {%- render 'ob-brand-logotype', collection: block.settings.collection, brand_handle: block.settings.brand_handle -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "OB Merken-marquee",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "De scrollende merkenband. Beheer de merken hier, voor alle hero's tegelijk. Zet deze sectie direct onder de hero's."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Merk",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie"
        },
        {
          "type": "text",
          "id": "brand_handle",
          "label": "Merk-handle (fallback)",
          "info": "Alleen invullen als de collectie hierboven nog niet bestaat (bv. \"rh-plus\"). Bepaalt dan het logo en de link (/collections/<handle>)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Merken-marquee"
    }
  ]
}
{% endschema %}
