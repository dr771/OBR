{% comment %}
  OB: homepage brand marquee - a continuously scrolling row of brand
  wordmarks just under the hero, matched to bolt's `animate-marquee` strip.
  Reuses snippets/ob-brand-logotype.liquid (built for the Merken hero chips)
  so the same brand typography shows up here for free.

  The block list is rendered twice back-to-back so a -50%-of-one-set
  translateX loops seamlessly; assets/ob-home-marquee.js drives that
  translateX itself (not a CSS keyframe - see that file for why) and eases
  the speed down on hover/focus instead of pausing outright. Skipped
  entirely under reduced motion (both the JS and the CSS wrap fallback).
{% endcomment %}
{{ 'component-ob-home-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ob-home-marquee.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="ob-home-marquee section-{{ section.id }}-padding">
    <div class="ob-home-marquee__track">
      {%- for copy in (1..2) -%}
        <div class="ob-home-marquee__set" aria-hidden="{% unless copy == 1 %}true{% endunless %}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign ob_mq_handle = block.settings.collection.handle | default: block.settings.brand_handle
              assign ob_mq_url = block.settings.collection.url
              if ob_mq_url == blank and block.settings.brand_handle != blank
                assign ob_mq_url = routes.collections_url | append: '/' | append: block.settings.brand_handle
              endif
            -%}
            {%- if ob_mq_handle != blank -%}
              <a
                href="{{ ob_mq_url }}"
                class="ob-home-marquee__item"
                {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}
                {% if copy == 2 %}tabindex="-1"{% endif %}
              >
                {%- render 'ob-brand-logotype', collection: block.settings.collection, brand_handle: block.settings.brand_handle -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "OB Brand marquee",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Merk",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie"
        },
        {
          "type": "text",
          "id": "brand_handle",
          "label": "Merk-handle (fallback)",
          "info": "Alleen invullen als de collectie hierboven nog niet bestaat (bv. \"rh-plus\"). Bepaalt dan het logo en de link (/collections/<handle>)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Brand marquee",
      "blocks": [
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
