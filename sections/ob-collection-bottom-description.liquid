{%- capture bottom_content -%}
  {{- collection.metafields.custom.bottom_description | metafield_tag -}}
{%- endcapture -%}
{%- assign bottom_text = bottom_content | strip_html | strip -%}

{%- if bottom_text != blank -%}
  {{ 'component-ob-collection-bottom-description.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    #shopify-section-{{ section.id }} .ob-collection-bottom-description {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .ob-collection-bottom-description {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="ob-collection-bottom-description color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <div class="ob-collection-bottom-description__body rte">
        {{ bottom_content }}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collectie ondertekst",
  "tag": "section",
  "class": "ob-collection-bottom-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Collectie ondertekst"
    }
  ]
}
{% endschema %}
