{% comment %}
  OB: homepage outlet/promo banner, matched to bolt's dark rounded promo
  card. Links to the real "Solden" collection - the same collection the
  footer's "Outlet" link already resolves to, so this banner uses the same
  informal "outlet" marketing language the footer already established for it
  rather than the literal Dutch collection title.
{% endcomment %}
{{ 'component-ob-home-promo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="ob-home-promo">
    <div class="ob-home-promo__content">
      {%- if section.settings.badge != blank -%}
        <span class="ob-home-promo__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ob-home-promo__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ob-home-promo__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="ob-home-promo__button">
          {{ section.settings.button_label }}
          {%- render 'ob-icon', icon: 'chevron-right' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "OB Outlet promo",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Beperkte stock · op = op"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Slim gekozen. Extra scherp geprijsd."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Onderschrift",
      "default": "Ontdek outlet-deals op topmerken tot -40%. Kwaliteit die blijft, tegen een prijs die verrast."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop label",
      "default": "Shop de outlet"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knop link"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "OB Outlet promo"
    }
  ]
}
{% endschema %}
