{% comment %}
  Native wishlist: one compact cart cross-sell row, fetched by
  ob-wishlist-items.js through the Section Rendering API on the product's own
  URL (/products/<handle>?section_id=ob-wishlist-item-compact&variant=<id>).
  Not meant for templates, so it has no presets.
{% endcomment %}
{%- if product -%}
  {% render 'ob-wishlist-item', product: product, layout: 'compact' %}
{%- endif -%}

{% schema %}
{
  "name": "OB Wishlist row",
  "settings": []
}
{% endschema %}
